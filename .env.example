# --- Required ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# Your Signal number in international format, e.g. +9665XXXXXXXX (the account you link to)
SIGNAL_NUMBER=
# Group to post to. Find it with: docker compose run --rm worker python -m digest groups
SIGNAL_GROUP_ID=

# Free models (planning, reading pages, ranking, review): openrouter.ai -> Keys
OPENROUTER_API_KEY=

# --- LangSmith tracing (optional, recommended) ---------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tech-digest

# --- Health alerts (optional): a healthchecks.io ping URL ------------------------
HEALTHCHECK_URL=

# --- Schedule: checks daily at RUN_HOUR, sends only if the last digest is 47h+ old --
TZ=Asia/Riyadh
RUN_HOUR=8
MIN_HOURS_BETWEEN=47

# --- Tuning (defaults shown) ------------------------------------------------------
# Hard spending cap per run (USD)
# RUN_BUDGET_USD=1.00
# SEARCH_MODEL=claude-haiku-4-5
# WRITER_MODEL=claude-sonnet-5-5
# Free OpenRouter models, tried in order (comma-separated); agents fall back to Claude Haiku
# FREE_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free
# Research agent guard rails (per agent run)
# SEARCH_MAX_USES=5
# RETRY_SEARCH_MAX_USES=3
# PAGES_PER_THREAD=8
# AGENT_MAX_STEPS=20
# RETRY_MAX_STEPS=12
# MAX_RESEARCH_ATTEMPTS=2
# Seconds per agent (first try / retry); verified items that make retries unnecessary
# AGENT_TIME_LIMIT_S=240
# RETRY_TIME_LIMIT_S=120
# ENOUGH_ITEMS=3
# PAGE_MAX_CHARS=12000
# AGENT_PAGE_CHARS=6000
# MAX_ITEMS=7
# MAX_CHARS=2000
# DEDUPE_DAYS=14
